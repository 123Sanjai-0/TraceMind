# ==========================================
# TRACEMIND PLATFORM CONFIGURATION TEMPLATE
# ==========================================

# Database Connection (SQLite default for local development, or PostgreSQL for production)
DATABASE_URL=sqlite:///./tracemind.db
# DATABASE_URL=postgresql://tracemind:tracemind_secure_pwd@localhost:5432/tracemind

# Anomaly Detection Settings
Z_SCORE_THRESHOLD=2.5
LATENCY_DEVIATION_PCT_THRESHOLD=50.0
ERROR_RATE_THRESHOLD=0.05
TIME_WINDOW_MINUTES=15

# LLM Provider Configuration ("mock", "openai", "anthropic", "gemini")
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_MODEL_NAME=gpt-4o-mini

# RAG Knowledge Base Settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=3
